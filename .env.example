# Template for the local env file. Copy it outside the repo, e.g.
#   ~/.config/ticket-reservation/ticket-reservation.env
# or point ENV_FILE at wherever you keep it.
# Format: KEY=value, one per line, no quotes, no spaces around '='.

DATABASE_URL=jdbc:mysql://localhost:3306/ticket_reservation?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DATABASE_USERNAME=root
DATABASE_PASSWORD=

DB_POOL_MIN_IDLE=10
DB_POOL_MAX_SIZE=20

JWT_SECRET=
ADMIN_SECRET=
